{
  "manifest_version": 3,
  "name": "MASSIVE Discipline",
  "version": "0.3.0",
  "description": "MASSIVE discipline ticket: daily plan, deliberate override, and local trader record.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://sandbox.myfundedperpetuals.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://myfundedperpetuals.com/trade/*",
        "https://www.myfundedperpetuals.com/trade/*"
      ],
      "js": [
        "panel.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "panel.css",
        "manrope-700.ttf",
        "manrope-800.ttf"
      ],
      "matches": [
        "https://myfundedperpetuals.com/*",
        "https://www.myfundedperpetuals.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "Open MASSIVE Discipline",
    "default_popup": "popup.html"
  }
}
